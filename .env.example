NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_NAME=Pockymoe Supervisor
APP_VERSION=0.1.0
WORKSPACE_ROOT=
DATABASE_URL=
POCKYMOE_MODE=local
# Required when POCKYMOE_MODE=server or POCKYMOE_MODE=relay.
POCKYMOE_ADMIN_USERNAME=
POCKYMOE_ADMIN_PASSWORD=
POCKYMOE_SESSION_SECRET=
POCKYMOE_SESSION_TTL_SECONDS=604800
# Used by the home supervisor when POCKYMOE_MODE=relay.
POCKYMOE_RELAY_SERVER_URL=
POCKYMOE_RELAY_AGENT_TOKEN=
POCKYMOE_RELAY_SUPERVISOR_PORT=45679
# Used by apps/relay-server on the public relay server.
# Optional legacy bootstrap token. New devices should use tokens created in /relay-portal.
POCKYMOE_RELAY_PORT=8798
POCKYMOE_RELAY_SUPERVISOR_TOKEN=
POCKYMOE_RELAY_DATA_DIR=
POCKYMOE_RELAY_SESSION_SECRET=
POCKYMOE_RELAY_REGISTRATION_ENABLED=true
POCKYMOE_PUBLIC_BASE_URL=
# Optional private HTTP previews. Requires wildcard DNS/TLS and ingress routing.
# Example: https://example.com produces https://p-<mapping-id>.example.com
POCKYMOE_PORT_PREVIEW_BASE_URL=
POCKYMOE_GOOGLE_OAUTH_CLIENT_ID=
POCKYMOE_GOOGLE_OAUTH_CLIENT_SECRET=
POCKYMOE_GOOGLE_OAUTH_ENABLED=true
POCKYMOE_GITHUB_OAUTH_CLIENT_ID=
POCKYMOE_GITHUB_OAUTH_CLIENT_SECRET=
POCKYMOE_GITHUB_OAUTH_ENABLED=true
# Email verification remains unavailable until both are configured.
POCKYMOE_EMAIL_VERIFICATION_SECRET=
POCKYMOE_POSTMARK_SERVER_TOKEN=
POCKYMOE_RELAY_WEB_DIST_DIR=
CODEX_HOME=
CODEX_COMMAND=codex
CODEX_APP_SERVER_START_TIMEOUT_MS=10000

# Relay only: trust forwarding chains solely from these actual proxy IPs.
# Empty means ignore forwarding headers. A loopback reverse proxy uses 127.0.0.1.
POCKYMOE_TRUSTED_PROXY_IPS=
