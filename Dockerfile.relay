# syntax=docker/dockerfile:1.7

FROM rust:1.89-bookworm AS rust-build

WORKDIR /opt/pockymoe

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY config ./config
COPY skills ./skills

RUN --mount=type=cache,id=pockymoe-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=pockymoe-cargo-target,target=/opt/pockymoe/target,sharing=locked \
    cargo build --locked --release --package pockymoe \
    && install -Dm0755 target/release/pockymoe /out/pockymoe

FROM node:22-bookworm-slim AS web-build

ARG POCKYMOE_THREAD_UI_REPO=https://github.com/dufangshi/pockymoe-thread-ui-rust.git
ARG POCKYMOE_THREAD_UI_REF=main
ARG POCKYMOE_THREAD_UI_CACHE_BUST=local

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@10.11.1 --activate

WORKDIR /opt/pockymoe

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/supervisor-web ./apps/supervisor-web
COPY packages/plugin-runtime ./packages/plugin-runtime
COPY packages/plugin-terminal ./packages/plugin-terminal
COPY packages/shared ./packages/shared
COPY themes ./themes

RUN echo "thread-ui cache key: ${POCKYMOE_THREAD_UI_CACHE_BUST}" \
    && git init ./pockymoe-thread-ui \
    && git -C ./pockymoe-thread-ui remote add origin "${POCKYMOE_THREAD_UI_REPO}" \
    && git -C ./pockymoe-thread-ui fetch --depth 1 origin "${POCKYMOE_THREAD_UI_REF}" \
    && git -C ./pockymoe-thread-ui checkout --detach FETCH_HEAD \
    && git -C ./pockymoe-thread-ui rev-parse HEAD

RUN --mount=type=cache,id=pockymoe-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm config set store-dir /pnpm/store \
    && pnpm --dir ./pockymoe-thread-ui install --frozen-lockfile \
    && pnpm --dir ./pockymoe-thread-ui --filter @pockymoe/thread-ui build \
    && pnpm --filter @pockymoe/supervisor-web... install --frozen-lockfile \
    && pnpm --filter @pockymoe/supervisor-web build

FROM debian:bookworm-slim AS runtime

ARG POCKYMOE_UID=1000
ARG POCKYMOE_GID=1000

ENV HOST=0.0.0.0 \
    PORT=8788 \
    POCKYMOE_RELAY_HOST=0.0.0.0 \
    POCKYMOE_RELAY_PORT=8788 \
    POCKYMOE_RELAY_DATA_DIR=/var/lib/remote-codex-relay \
    POCKYMOE_RELAY_WEB_DIST_DIR=/opt/pockymoe/apps/supervisor-web/dist

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${POCKYMOE_GID}" pockymoe \
    && useradd \
      --uid "${POCKYMOE_UID}" \
      --gid "${POCKYMOE_GID}" \
      --home-dir /var/lib/remote-codex-relay \
      --no-create-home \
      --shell /usr/sbin/nologin \
      pockymoe \
    && install -d -o "${POCKYMOE_UID}" -g "${POCKYMOE_GID}" \
      /var/lib/remote-codex-relay \
      /opt/pockymoe/apps/supervisor-web/dist

COPY --from=rust-build --chown=1000:1000 /out/pockymoe /usr/local/bin/pockymoe
COPY --from=web-build --chown=1000:1000 /opt/pockymoe/apps/supervisor-web/dist /opt/pockymoe/apps/supervisor-web/dist

WORKDIR /opt/pockymoe

USER 1000:1000

EXPOSE 8788
VOLUME ["/var/lib/remote-codex-relay"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl --fail --silent --show-error --max-time 4 \
    "http://127.0.0.1:${POCKYMOE_RELAY_PORT:-8788}/healthz" >/dev/null

CMD ["pockymoe", "relay"]
